DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/dentex_dev"
JWT_SECRET="replace-with-at-least-32-random-characters"
APP_ORIGIN="http://localhost:5173"
PORT=3000
# Local default; Docker sets HOST=0.0.0.0 inside its isolated container.
HOST=127.0.0.1

# Optional: only explicitly trusted reverse-proxy IP addresses/CIDRs, e.g. 127.0.0.1,::1
TRUST_PROXY=""
