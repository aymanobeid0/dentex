# Paste into the staging Compose Environment tab in Dokploy.
# Generate distinct random hex values; do not reuse local or production secrets.
STAGING_DB_PASSWORD=replace_with_64_random_hex_characters
STAGING_JWT_SECRET=replace_with_at_least_64_random_hex_characters
# Optional: exact Traefik peer IP/CIDR after checking the deployed network.
# An empty value preserves the existing no-trusted-proxy default.
STAGING_TRUST_PROXY=
