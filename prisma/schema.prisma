generator client {
  provider = "prisma-client"
  output = "../generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "ts"
}
datasource db {
  provider = "postgresql"
}
model Clinic {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String
  code String @unique @db.VarChar(4)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  users User[]
  roles Role[]
  patients Patient[]
  @@map("clinics")
}
model Patient {
  editVersion Int @default(1) @map("edit_version")
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId String @map("clinic_id") @db.Uuid
  fileNumber BigInt @default(autoincrement()) @map("file_number")
  name String @db.VarChar(200)
  phone String @db.VarChar(12)
  gender String @db.VarChar(6)
  isChild Boolean @default(false) @map("is_child")
  birthDate DateTime? @map("birth_date") @db.Date
  address String? @db.VarChar(500)
  administrativeNote String? @map("administrative_note") @db.VarChar(2000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@unique([clinicId, fileNumber])
  @@map("patients")
}
model PlatformAdmin {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username String @unique
  email String @unique
  passwordHash String @map("password_hash")
  active Boolean @default(true)
  credentialVersion Int @default(1) @map("credential_version")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@map("platform_admins")
}
model User {
  editVersion Int @default(1) @map("edit_version")
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId String @map("clinic_id") @db.Uuid
  name String
  username String
  email String?
  passwordHash String @map("password_hash")
  active Boolean @default(true)
  credentialVersion Int @default(1) @map("credential_version")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userRoles UserRole[]
  @@unique([clinicId, username])
  @@unique([clinicId, id])
  @@map("users")
}
model Role {
  editVersion Int @default(1) @map("edit_version")
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId String @map("clinic_id") @db.Uuid
  key String
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userRoles UserRole[]
  permissions RolePermission[]
  @@unique([clinicId, key])
  @@unique([clinicId, id])
  @@map("roles")
}
model UserRole {
  clinicId String @map("clinic_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user User @relation(fields: [clinicId, userId], references: [clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  role Role @relation(fields: [clinicId, roleId], references: [clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  @@id([userId, roleId])
  @@map("user_roles")
}
model Permission {
  key String @id
  roles RolePermission[]
  @@map("permissions")
}
model RolePermission {
  roleId String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")
  role Role @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: NoAction, onUpdate: NoAction)
  @@id([roleId, permissionKey])
  @@map("role_permissions")
}
