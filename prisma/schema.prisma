generator client {
  provider = "prisma-client"
  output = "../generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "ts"
}
datasource db {
  provider = "postgresql"
}
model Clinic {
  treatmentPlans TreatmentPlan[]
  attendanceCorrections AttendanceCorrection[]
  appointmentVisitLinks AppointmentVisitLink[]
  appointmentVisitPins AppointmentVisitPin[]
  appointmentVisitChanges AppointmentVisitChange[]
  visits Visit[]
  attendances Attendance[]
  appointments Appointment[]
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String
  code String @unique @db.VarChar(4)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  users User[]
  roles Role[]
  patients Patient[]
  patientNumbering PatientNumbering?
  @@map("clinics")
}
model Patient {
  procedures TreatmentProcedure[]
  treatmentPlans TreatmentPlan[]
  visits Visit[]
  attendances Attendance[]
  appointments Appointment[]
  archived Boolean @default(false)
  editVersion Int @default(1) @map("edit_version")
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId String @map("clinic_id") @db.Uuid
  fileNumber BigInt @map("file_number")
  name String @db.VarChar(200)
  phone String @db.VarChar(12)
  gender String @db.VarChar(6)
  isChild Boolean @default(false) @map("is_child")
  birthDate DateTime? @map("birth_date") @db.Date
  address String? @db.VarChar(500)
  administrativeNote String? @map("administrative_note") @db.VarChar(2000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  numberingHistory PatientNumberHistory[]
  @@unique([clinicId, id])
  @@unique([clinicId, fileNumber])
  @@map("patients")
}
model TreatmentPlan {
  id String @id @db.Uuid
  clinicId String @map("clinic_id") @db.Uuid
  patientId String @map("patient_id") @db.Uuid
  title String @db.VarChar(200)
  notes String @db.VarChar(2000)
  status String @default("active") @db.VarChar(12)
  editVersion Int @default(1) @map("edit_version")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  clinic Clinic @relation(fields:[clinicId], references:[id], onDelete:NoAction, onUpdate:NoAction)
  patient Patient @relation(fields:[clinicId,patientId], references:[clinicId,id], onDelete:NoAction, onUpdate:NoAction)
  items TreatmentItem[]
  history TreatmentChange[]
  @@unique([clinicId,id])
  @@index([clinicId,patientId,createdAt])
  @@map("treatment_plans")
}
model TreatmentItem {
  procedures TreatmentProcedure[]
  id String @id @db.Uuid
  clinicId String @map("clinic_id") @db.Uuid
  planId String @map("plan_id") @db.Uuid
  description String @db.VarChar(200)
  location String @db.VarChar(80)
  notes String @db.VarChar(2000)
  status String @default("pending") @db.VarChar(12)
  editVersion Int @default(1) @map("edit_version")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  plan TreatmentPlan @relation(fields:[clinicId,planId], references:[clinicId,id], onDelete:NoAction, onUpdate:NoAction)
  @@unique([clinicId,id])
  @@index([clinicId,planId,createdAt])
  @@map("treatment_items")
}
model TreatmentProcedure {
  id String @id @db.Uuid
  clinicId String @map("clinic_id") @db.Uuid
  patientId String @map("patient_id") @db.Uuid
  visitId String @map("visit_id") @db.Uuid
  itemId String? @map("item_id") @db.Uuid
  description String @db.VarChar(200)
  location String @db.VarChar(80)
  notes String @db.VarChar(2000)
  actorId String @map("actor_id") @db.Uuid
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz
  editVersion Int @default(1) @map("edit_version")
  voidedAt DateTime? @map("voided_at") @db.Timestamptz
  voidActorId String? @map("void_actor_id") @db.Uuid
  voidReason String? @map("void_reason") @db.VarChar(500)
  patient Patient @relation(fields:[clinicId,patientId], references:[clinicId,id], onDelete:NoAction, onUpdate:NoAction)
  visit Visit @relation(fields:[clinicId,visitId], references:[clinicId,id], onDelete:NoAction, onUpdate:NoAction)
  item TreatmentItem? @relation(fields:[clinicId,itemId], references:[clinicId,id], onDelete:NoAction, onUpdate:NoAction)
  actor User @relation("ProcedureActor",fields:[clinicId,actorId], references:[clinicId,id], onDelete:NoAction, onUpdate:NoAction)
  voidActor User? @relation("ProcedureVoidActor",fields:[clinicId,voidActorId], references:[clinicId,id], onDelete:NoAction, onUpdate:NoAction)
  @@index([clinicId,visitId,recordedAt])
  @@index([clinicId,patientId])
  @@map("treatment_procedures")
}
model TreatmentChange {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId String @map("clinic_id") @db.Uuid
  planId String @map("plan_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  kind String @db.VarChar(32)
  reason String? @db.VarChar(500)
  before Json
  after Json
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz
  plan TreatmentPlan @relation(fields:[clinicId,planId], references:[clinicId,id], onDelete:NoAction, onUpdate:NoAction)
  actor User @relation(fields:[clinicId,actorId], references:[clinicId,id], onDelete:NoAction, onUpdate:NoAction)
  @@index([clinicId,planId,recordedAt])
  @@map("treatment_changes")
}
model PlatformAdmin {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username String @unique
  email String @unique
  passwordHash String @map("password_hash")
  active Boolean @default(true)
  credentialVersion Int @default(1) @map("credential_version")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@map("platform_admins")
}
model User {
  treatmentProcedures TreatmentProcedure[] @relation("ProcedureActor")
  voidedProcedures TreatmentProcedure[] @relation("ProcedureVoidActor")
  treatmentChanges TreatmentChange[]
  attendanceCorrections AttendanceCorrection[]
  appointmentVisitChanges AppointmentVisitChange[]
  visits Visit[] @relation("VisitDoctor")
  recordedVisits Visit[] @relation("VisitCreator")
  attendances Attendance[] @relation("AttendanceDoctor")
  recordedAttendances Attendance[] @relation("AttendanceCreator")
  appointments Appointment[] @relation("AppointmentDoctor")
  createdAppointments Appointment[] @relation("AppointmentCreator")
  appointmentChanges AppointmentChange[]
  editVersion Int @default(1) @map("edit_version")
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId String @map("clinic_id") @db.Uuid
  name String
  username String
  email String?
  passwordHash String @map("password_hash")
  active Boolean @default(true)
  credentialVersion Int @default(1) @map("credential_version")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userRoles UserRole[]
  @@unique([clinicId, username])
  @@unique([clinicId, id])
  @@map("users")
}

model Attendance {
  effectiveClosedAt DateTime? @map("effective_closed_at") @db.Timestamptz
  autoClosedRecordedAt DateTime? @map("auto_closed_recorded_at") @db.Timestamptz
  corrections AttendanceCorrection[]
  visits Visit[]
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId String @map("clinic_id") @db.Uuid
  patientId String @map("patient_id") @db.Uuid
  doctorId String @map("doctor_id") @db.Uuid
  status String @default("waiting") @db.VarChar(24)
  arrivedAt DateTime @default(now()) @map("arrived_at") @db.Timestamptz
  arrivalSequence BigInt @unique @default(autoincrement()) @map("arrival_sequence")
  recordedEndAt DateTime? @map("recorded_end_at") @db.Timestamptz
  createdBy String @map("created_by") @db.Uuid
  editVersion Int @default(1) @map("edit_version")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patient Patient @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  doctor User @relation("AttendanceDoctor", fields: [clinicId, doctorId], references: [clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  creator User @relation("AttendanceCreator", fields: [clinicId, createdBy], references: [clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  @@unique([clinicId, id])
  @@index([clinicId, doctorId, status, arrivedAt, arrivalSequence])
  @@map("attendances")
}
model Visit {
  procedures TreatmentProcedure[]
  effectiveClosedAt DateTime? @map("effective_closed_at") @db.Timestamptz
  autoClosedRecordedAt DateTime? @map("auto_closed_recorded_at") @db.Timestamptz
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId String @map("clinic_id") @db.Uuid
  attendanceId String @map("attendance_id") @db.Uuid
  patientId String @map("patient_id") @db.Uuid
  doctorId String @map("doctor_id") @db.Uuid
  createdBy String @map("created_by") @db.Uuid
  status String @default("in_progress") @db.VarChar(24)
  startedAt DateTime @map("started_at") @db.Timestamptz
  recordedEndAt DateTime? @map("recorded_end_at") @db.Timestamptz
  editVersion Int @default(1) @map("edit_version")
  attendance Attendance @relation(fields: [clinicId, attendanceId], references: [clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patient Patient @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  doctor User @relation("VisitDoctor", fields: [clinicId, doctorId], references: [clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  creator User @relation("VisitCreator", fields: [clinicId, createdBy], references: [clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  @@unique([clinicId, id])
  @@index([clinicId, attendanceId, startedAt])
  @@map("visits")
}
model Role {
  editVersion Int @default(1) @map("edit_version")
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId String @map("clinic_id") @db.Uuid
  key String
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userRoles UserRole[]
  permissions RolePermission[]
  @@unique([clinicId, key])
  @@unique([clinicId, id])
  @@map("roles")
}
model UserRole {
  clinicId String @map("clinic_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user User @relation(fields: [clinicId, userId], references: [clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  role Role @relation(fields: [clinicId, roleId], references: [clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  @@id([userId, roleId])
  @@map("user_roles")
}
model Permission {
  key String @id
  roles RolePermission[]
  @@map("permissions")
}
model RolePermission {
  roleId String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")
  role Role @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: NoAction, onUpdate: NoAction)
  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model PatientNumbering {
  clinicId String @id @map("clinic_id") @db.Uuid
  start BigInt
  lastNumber BigInt @map("last_number")
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@map("patient_numbering")
}
model PatientNumberHistory {
  clinicId String @map("clinic_id") @db.Uuid
  oldFileNumber BigInt @map("old_file_number")
  patientId String @unique @map("patient_id") @db.Uuid
  patient Patient @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: Cascade, onUpdate: NoAction)
  @@id([clinicId, oldFileNumber])
  @@map("patient_number_history")
}

model Appointment {
  visitLinks AppointmentVisitLink[]
  visitPins AppointmentVisitPin[]
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId String @map("clinic_id") @db.Uuid
  patientId String @map("patient_id") @db.Uuid
  doctorId String @map("doctor_id") @db.Uuid
  startsAt DateTime @map("starts_at") @db.Timestamptz
  endsAt DateTime @map("ends_at") @db.Timestamptz
  status String @default("booked") @db.VarChar(12)
  administrativeNote String? @map("administrative_note") @db.VarChar(2000)
  editVersion Int @default(1) @map("edit_version")
  createdBy String @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patient Patient @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  doctor User @relation("AppointmentDoctor", fields: [clinicId, doctorId], references: [clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  creator User @relation("AppointmentCreator", fields: [clinicId, createdBy], references: [clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  changes AppointmentChange[]
  @@unique([clinicId, id])
  @@index([clinicId, startsAt])
  @@map("appointments")
}

model AppointmentChange {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId String @map("clinic_id") @db.Uuid
  appointmentId String @map("appointment_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  action String @db.VarChar(20)
  before Json?
  after Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  appointment Appointment @relation(fields: [clinicId, appointmentId], references: [clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  actor User @relation(fields: [clinicId, actorId], references: [clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  @@index([clinicId, appointmentId, createdAt])
  @@map("appointment_changes")
}

// Appointment-owned references: visitId is deliberately opaque (no visits FK).
model AppointmentVisitLink {
  clinicId String @map("clinic_id") @db.Uuid
  visitId String @map("visit_id") @db.Uuid
  appointmentId String? @map("appointment_id") @db.Uuid
  editVersion Int @map("edit_version")
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  appointment Appointment? @relation(fields: [clinicId, appointmentId], references: [clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  @@id([clinicId, visitId])
  @@unique([clinicId, appointmentId])
  @@map("appointment_visit_links")
}

model AppointmentVisitPin {
  clinicId String @map("clinic_id") @db.Uuid
  appointmentId String @map("appointment_id") @db.Uuid
  visitId String @map("visit_id") @db.Uuid
  visitDay String @map("visit_day") @db.VarChar(10)
  valid Boolean @default(true)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  appointment Appointment @relation(fields: [clinicId, appointmentId], references: [clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  @@id([clinicId, appointmentId, visitId])
  @@map("appointment_visit_pins")
}

model AppointmentVisitChange {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId String @map("clinic_id") @db.Uuid
  visitId String @map("visit_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  action String @db.VarChar(20)
  before Json
  after Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actor User @relation(fields: [clinicId, actorId], references: [clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  @@index([clinicId, visitId, createdAt])
  @@map("appointment_visit_changes")
}

model AttendanceCorrection {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId String @map("clinic_id") @db.Uuid
  attendanceId String @map("attendance_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  kind String @db.VarChar(32)
  reason String? @db.VarChar(500)
  before Json
  after Json
  recordedAt DateTime @map("recorded_at") @db.Timestamptz
  clinic Clinic @relation(fields:[clinicId], references:[id], onDelete:NoAction, onUpdate:NoAction)
  attendance Attendance @relation(fields:[clinicId,attendanceId], references:[clinicId,id], onDelete:Cascade, onUpdate:NoAction)
  actor User @relation(fields:[clinicId,actorId], references:[clinicId,id], onDelete:NoAction, onUpdate:NoAction)
  @@index([clinicId,attendanceId,recordedAt])
  @@map("attendance_corrections")
}
