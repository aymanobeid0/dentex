generator client {
  provider = "prisma-client"
  output = "../generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "ts"
}
datasource db {
  provider = "postgresql"
}
model Clinic {
  appointments Appointment[]
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String
  code String @unique @db.VarChar(4)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  users User[]
  roles Role[]
  patients Patient[]
  patientNumbering PatientNumbering?
  @@map("clinics")
}
model Patient {
  appointments Appointment[]
  archived Boolean @default(false)
  editVersion Int @default(1) @map("edit_version")
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId String @map("clinic_id") @db.Uuid
  fileNumber BigInt @map("file_number")
  name String @db.VarChar(200)
  phone String @db.VarChar(12)
  gender String @db.VarChar(6)
  isChild Boolean @default(false) @map("is_child")
  birthDate DateTime? @map("birth_date") @db.Date
  address String? @db.VarChar(500)
  administrativeNote String? @map("administrative_note") @db.VarChar(2000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  numberingHistory PatientNumberHistory[]
  @@unique([clinicId, id])
  @@unique([clinicId, fileNumber])
  @@map("patients")
}
model PlatformAdmin {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username String @unique
  email String @unique
  passwordHash String @map("password_hash")
  active Boolean @default(true)
  credentialVersion Int @default(1) @map("credential_version")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@map("platform_admins")
}
model User {
  appointments Appointment[] @relation("AppointmentDoctor")
  createdAppointments Appointment[] @relation("AppointmentCreator")
  appointmentChanges AppointmentChange[]
  editVersion Int @default(1) @map("edit_version")
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId String @map("clinic_id") @db.Uuid
  name String
  username String
  email String?
  passwordHash String @map("password_hash")
  active Boolean @default(true)
  credentialVersion Int @default(1) @map("credential_version")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userRoles UserRole[]
  @@unique([clinicId, username])
  @@unique([clinicId, id])
  @@map("users")
}
model Role {
  editVersion Int @default(1) @map("edit_version")
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId String @map("clinic_id") @db.Uuid
  key String
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userRoles UserRole[]
  permissions RolePermission[]
  @@unique([clinicId, key])
  @@unique([clinicId, id])
  @@map("roles")
}
model UserRole {
  clinicId String @map("clinic_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user User @relation(fields: [clinicId, userId], references: [clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  role Role @relation(fields: [clinicId, roleId], references: [clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  @@id([userId, roleId])
  @@map("user_roles")
}
model Permission {
  key String @id
  roles RolePermission[]
  @@map("permissions")
}
model RolePermission {
  roleId String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")
  role Role @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: NoAction, onUpdate: NoAction)
  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model PatientNumbering {
  clinicId String @id @map("clinic_id") @db.Uuid
  start BigInt
  lastNumber BigInt @map("last_number")
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@map("patient_numbering")
}
model PatientNumberHistory {
  clinicId String @map("clinic_id") @db.Uuid
  oldFileNumber BigInt @map("old_file_number")
  patientId String @unique @map("patient_id") @db.Uuid
  patient Patient @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: Cascade, onUpdate: NoAction)
  @@id([clinicId, oldFileNumber])
  @@map("patient_number_history")
}

model Appointment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId String @map("clinic_id") @db.Uuid
  patientId String @map("patient_id") @db.Uuid
  doctorId String @map("doctor_id") @db.Uuid
  startsAt DateTime @map("starts_at") @db.Timestamptz
  endsAt DateTime @map("ends_at") @db.Timestamptz
  status String @default("booked") @db.VarChar(12)
  administrativeNote String? @map("administrative_note") @db.VarChar(2000)
  editVersion Int @default(1) @map("edit_version")
  createdBy String @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patient Patient @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  doctor User @relation("AppointmentDoctor", fields: [clinicId, doctorId], references: [clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  creator User @relation("AppointmentCreator", fields: [clinicId, createdBy], references: [clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  changes AppointmentChange[]
  @@unique([clinicId, id])
  @@index([clinicId, startsAt])
  @@map("appointments")
}

model AppointmentChange {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId String @map("clinic_id") @db.Uuid
  appointmentId String @map("appointment_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  action String @db.VarChar(20)
  before Json?
  after Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  appointment Appointment @relation(fields: [clinicId, appointmentId], references: [clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  actor User @relation(fields: [clinicId, actorId], references: [clinicId, id], onDelete: NoAction, onUpdate: NoAction)
  @@index([clinicId, appointmentId, createdAt])
  @@map("appointment_changes")
}
